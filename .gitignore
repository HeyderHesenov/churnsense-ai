# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.streamlit/secrets.toml

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-runtime/
venv/
sbom.cdx.json
.Python

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- Data: raw data stays out of git (reproducible via `make data`) ---
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# --- Trained artifacts are build output, not source ---
artifacts/*
!artifacts/.gitkeep

# --- Generated reports: figures are regenerated by `make eda` ---
reports/figures/*
!reports/figures/.gitkeep

# --- Validation sweep reports: written by `make train`, kept out of git (E8, 2026-11-12) ---
# They state the validation sweep at every 0.01 and segment cells of a few customers.
# Earlier commits still hold them: see docs/DEPLOYMENT.md, section 20.
reports/threshold_sweep.csv
reports/model_comparison.md

# --- OS ---
.DS_Store

# --- Front end (frontend/): dependencies and build output are not source ---
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/

# Intermediate output of `npm run openapi`; the generated types are committed instead.
frontend/openapi.json

# --- Local browser-automation output (screenshots, snapshots) ---
.playwright-mcp/
