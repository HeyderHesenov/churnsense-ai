# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-runtime/
venv/
sbom.cdx.json
.Python

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- Data: raw data stays out of git (reproducible via `make data`) ---
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# --- Trained artifacts are build output, not source ---
artifacts/*
!artifacts/.gitkeep

# --- Generated reports: figures are regenerated by `make eda` ---
reports/figures/*
!reports/figures/.gitkeep

# --- OS ---
.DS_Store
