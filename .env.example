# ChurnSense AI - example environment file.
# Copy to `.env` and edit. `.env` is gitignored and must never be committed.
# Every value below has a safe default in configs/config.yaml; .env only overrides.

# Logging: DEBUG | INFO | WARNING | ERROR
CHURNSENSE_LOG_LEVEL=INFO

# Override the config file location (optional)
# CHURNSENSE_CONFIG=configs/config.yaml

# FastAPI bind address for `make api`
CHURNSENSE_API_HOST=127.0.0.1
CHURNSENSE_API_PORT=8000

# NOTE: this project uses no paid APIs and no external LLM services.
# There is deliberately no API-key setting here. If you ever add one,
# put it in .env (never in config.yaml, which IS committed).
