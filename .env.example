# ChurnSense AI - environment variables the code actually reads.
# Nothing loads a .env file automatically: export these in your shell (or use
# your tool's env-file support). Every setting has a default in configs/config.yaml.

# Logging level: DEBUG | INFO | WARNING | ERROR
CHURNSENSE_LOG_LEVEL=INFO

# Use a different config file (optional)
# CHURNSENSE_CONFIG=configs/config.yaml

# This project uses no paid APIs and no external services, so it has no keys.
# If one is ever added, keep it in .env (gitignored), never in config.yaml.
